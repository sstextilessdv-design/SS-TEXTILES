// storage.rules
// Replace YOUR_ADMIN_GOOGLE_EMAIL@gmail.com with the SAME email used in firebase-config.js.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Product images are publicly viewable because the shop is public.
    match /products/{allPaths=**} {
      allow read: if true;

      // Only the admin Google account can upload, update or delete product images.
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "YOUR_ADMIN_GOOGLE_EMAIL@gmail.com";
    }
  }
}
